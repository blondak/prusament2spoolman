{
  "name": "prusament-import",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:ui": "vite --host 0.0.0.0",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node dist/server/server/index.js",
    "preview:export": "vite build && node scripts/export-preview.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0",
    "vue": "^3.5.0",
    "vue-qrcode-reader": "5.7.3",
    "zod": "^3.24.0",
    "zxing-wasm": "1.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^6.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vue-tsc": "^2.2.0"
  }
}
