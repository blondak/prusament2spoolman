# Copy to .env and export these variables before starting the server.
PORT=8080
# Required unless DEMO_MODE=true. Use the base URL, including any reverse-proxy path.
SPOOLMAN_URL=http://spoolman:7912
# Optional browser-facing Spoolman address if different from the server address.
SPOOLMAN_PUBLIC_URL=
# Optional authentication sent only by the backend to Spoolman.
SPOOLMAN_API_KEY=
SPOOLMAN_API_HEADER=X-API-Key
# Optional PEM trust bundle. Node reads it at process startup.
# NODE_EXTRA_CA_CERTS=/path/to/ca.crt
REQUEST_TIMEOUT_MS=15000
DEMO_MODE=false
